{
  "name": "kvizovka-multiplayer",
  "version": "0.1.0",
  "private": true,
  "description": "Kvizovka online multiplayer - monorepo",
  "type": "module",
  "workspaces": [
    "packages/shared",
    "packages/client",
    "packages/server"
  ],
  "scripts": {
    "dev:client": "npm run dev --workspace=@kvizovka/client",
    "dev:server": "npm run dev --workspace=@kvizovka/server",
    "dev": "npm run dev:server & npm run dev:client",
    "build:shared": "npm run build --workspace=@kvizovka/shared",
    "build:client": "npm run build --workspace=@kvizovka/client",
    "build:server": "npm run build --workspace=@kvizovka/server",
    "build": "npm run build:shared && npm run build:client && npm run build:server",
    "type-check": "npm run type-check --workspaces",
    "clean": "rm -rf packages/*/dist packages/*/node_modules node_modules"
  },
  "devDependencies": {
    "typescript": "^5.2.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
